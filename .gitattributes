# Line endings are normalised to LF in the repository, whatever the machine
# that committed them. Without this, a Windows checkout commits CRLF and every
# file looks entirely rewritten to everyone else.
* text=auto eol=lf

# PowerShell is the exception: Windows PowerShell is happier with CRLF, and
# this script only ever runs there.
*.ps1 text eol=crlf

# Generated by tools/make_icons.py, and not text.
*.png binary
*.ico binary
*.icns binary
