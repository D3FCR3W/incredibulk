{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Incredibulk",
  "version": "0.1.1",
  "identifier": "dev.incredibulk.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Accumulating clipboard",
    "longDescription": "Open a copy session, collect as many fragments as you need, then paste them all as one block.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/D3FCR3W/incredibulk/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1NTNFQUMyMDZCNUE2QkUKUldTK3ByVUd3dXBUbFhwemQ2RnR3aUhPRENubXp3S3MzRUdsbUZWTlVSL2h4SjlBcWxQS0VZQlcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
